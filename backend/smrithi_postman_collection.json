            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Welcome to Smrithi memory care\",\n  \"language\": \"as\",\n  \"speed_rate\": 1.0\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/voice/synthesize",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "voice", "synthesize"]
            }
          }
        }
      ]
    }
  ]
}
